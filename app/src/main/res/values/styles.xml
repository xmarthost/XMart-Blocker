<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- XMart Host brand palette (from the website logo) -->
    <color name="bg">#0B1417</color>
    <color name="bg_top">#0F2329</color>
    <color name="surface">#12222A</color>
    <color name="surface2">#183039</color>
    <color name="stroke">#23414C</color>
    <color name="accent">#17A2AE</color>
    <color name="accent_bright">#3DD1D9</color>
    <color name="text">#F2F7F8</color>
    <color name="muted">#9FB4BA</color>
    <color name="good">#2BC48A</color>
    <color name="warn">#F5A524</color>
    <color name="bad">#E5484D</color>
    <color name="icon_bg">#FFFFFF</color>

    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="DialogTheme" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/accent_bright</item>
    </style>
</resources>
